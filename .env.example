# Copia este archivo a .env y completa los valores.
# En Cloudflare Pages se configuran como variables de entorno del proyecto.

# Número de WhatsApp de la secretaría parroquial.
# Solo dígitos, con código de país, SIN "+" ni espacios.
# Ejemplo (Guatemala): 50255551234
VITE_WHATSAPP=

# Teléfono del despacho parroquial (para las llamadas tel:).
# Solo dígitos, con código de país. Ejemplo: 50277901234
VITE_TELEFONO=
